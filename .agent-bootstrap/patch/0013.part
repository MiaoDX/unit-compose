diff --git a/examples/navigation_planning/src/inflation.rs b/examples/navigation_planning/src/inflation.rs
new file mode 100644
index 0000000000000000000000000000000000000000..375af700a4c0829f0d8c7434a97e0283765ab8a7
--- /dev/null
+++ b/examples/navigation_planning/src/inflation.rs
@@ -0,0 +1,98 @@
+use crate::resources::{CostMap, GridCell, OccupancyCell, OccupancyGrid};
+
+pub fn inflate_obstacles(
+    grid: &OccupancyGrid,
+    robot_radius_m: f64,
+    unknown_as_obstacle: bool,
+) -> Result<CostMap, String> {
+    if !robot_radius_m.is_finite() || robot_radius_m < 0.0 {
+        return Err("`robot_radius_m` must be a finite non-negative number".to_owned());
+    }
+    if !grid.resolution.is_finite() || grid.resolution <= 0.0 {
+        return Err("occupancy-grid resolution must be finite and positive".to_owned());
+    }
+    let expected_cells = grid
+        .width
+        .checked_mul(grid.height)
+        .ok_or("occupancy-grid dimensions overflow usize")?;
+    if grid.cells.len() != expected_cells {
+        return Err(format!(
+            "occupancy-grid storage has {} cells, expected {expected_cells}",
+            grid.cells.len()
+        ));
+    }
+    let mut blocked = vec![false; grid.cells.len()];
+    let radius_cells = (robot_radius_m / grid.resolution).ceil() as isize;
+    let radius_squared = (robot_radius_m / grid.resolution).powi(2) + f64::EPSILON;
+
+    for row in 0..grid.height {
+        for col in 0..grid.width {
+            let cell = GridCell::new(row, col);
+            let source_is_obstacle = matches!(grid.cell(cell), Some(OccupancyCell::Occupied))
+                || (unknown_as_obstacle
+                    && matches!(grid.cell(cell), Some(OccupancyCell::Unknown)));
+            if !source_is_obstacle {
+                continue;
+            }
+            for delta_row in -radius_cells..=radius_cells {
+                for delta_col in -radius_cells..=radius_cells {
+                    let distance_squared = (delta_row * delta_row + delta_col * delta_col) as f64;
+                    if distance_squared > radius_squared {
+                        continue;
+                    }
+                    let target_row = row as isize + delta_row;
+                    let target_col = col as isize + delta_col;
+                    if target_row < 0
+                        || target_col < 0
+                        || target_row >= grid.height as isize
+                        || target_col >= grid.width as isize
+                    {
+                        continue;
+                    }
+                    let index = target_row as usize * grid.width + target_col as usize;
+                    blocked[index] = true;
+                }
+            }
+        }
+    }
+
+    Ok(CostMap {
+        width: grid.width,
+        height: grid.height,
+        resolution: grid.resolution,
+        origin_x: grid.origin_x,
+        origin_y: grid.origin_y,
+        blocked,
+        inflation_radius_m: robot_radius_m,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn inflation_marks_radius_without_touching_far_cells() {
+        let mut cells = vec![OccupancyCell::Free; 25];
+        cells[12] = OccupancyCell::Occupied;
+        let grid = OccupancyGrid {
+            width: 5,
+            height: 5,
+            resolution: 1.0,
+            origin_x: 0.0,
+            origin_y: 0.0,
+            cells,
+        };
+        let costmap = inflate_obstacles(&grid, 1.0, true).unwrap();
+        for cell in [
+            GridCell::new(2, 2),
+            GridCell::new(1, 2),
+            GridCell::new(3, 2),
+            GridCell::new(2, 1),
+            GridCell::new(2, 3),
+        ] {
+            assert!(costmap.is_blocked(cell));
+        }
+        assert!(!costmap.is_blocked(GridCell::new(1, 1)));
+    }
+}
