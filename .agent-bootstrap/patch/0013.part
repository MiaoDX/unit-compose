+#![forbid(unsafe_code)]
+
+pub mod inflation;
+pub mod map_decoder;
+pub mod planners;
+pub mod resources;
+pub mod smoother;
+pub mod units;
+pub mod visualization;
+
+pub use units::register_navigation_units;
diff --git a/examples/navigation_planning/src/main.rs b/examples/navigation_planning/src/main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..812c203984f0d384c2f497a634382e54c3d62374
--- /dev/null
+++ b/examples/navigation_planning/src/main.rs
@@ -0,0 +1,248 @@
+use navigation_planning_demo::resources::{
+    CostMap, OccupancyGrid, PathPlan, PlanRequest, Point2, RosMapAsset, PLAN_REQUEST_TYPE,
+    ROS_MAP_ASSET_TYPE,
+};
+use navigation_planning_demo::{register_navigation_units, visualization::navigation_panel};
+use std::collections::BTreeMap;
+use std::env;
+use std::fs;
+use std::path::{Path, PathBuf};
+use unit_compose_core::{Module, ResourceValue, UnitRegistry};
+use unit_compose_debug_html::{render_dashboard, DashboardOptions};
+use unit_compose_yaml::parse_module_definition;
+
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("error: {error}");
+        std::process::exit(1);
+    }
+}
+
+fn run() -> Result<(), String> {
+    let args = Args::parse()?;
+    if args.help {
+        print_help();
+        return Ok(());
+    }
+
+    let yaml = fs::read_to_string(&args.module).map_err(|error| {
+        format!(
+            "cannot read Module Definition `{}`: {error}",
+            args.module.display()
+        )
+    })?;
+    let definition = parse_module_definition(&yaml).map_err(|error| error.to_string())?;
+    let mut registry = UnitRegistry::new();
+    register_navigation_units(&mut registry).map_err(|error| error.to_string())?;
+    let mut module = Module::build(definition, &registry).map_err(|error| error.to_string())?;
+
+    if args.describe {
+        println!("{}", module.debug_graph().describe());
+    }
+    if let Some(path) = &args.dot {
+        write_text(path, &module.debug_graph().to_dot())?;
+    }
+    if let Some(path) = &args.mermaid {
+        write_text(path, &module.debug_graph().to_mermaid())?;
+    }
+
+    let request = PlanRequest {
+        start: args.start,
+        goal: args.goal,
+    };
+    let inputs = BTreeMap::from([
+        (
+            "map_asset".to_owned(),
+            ResourceValue::new(
+                ROS_MAP_ASSET_TYPE,
