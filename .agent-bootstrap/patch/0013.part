diff --git a/examples/navigation_planning/configs/astar.yaml b/examples/navigation_planning/configs/astar.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..5174b481904899b0994b8391346325272d87ba1f
--- /dev/null
+++ b/examples/navigation_planning/configs/astar.yaml
@@ -0,0 +1,49 @@
+schema: unit-compose/v0alpha1
+module: navigation_planning_astar
+
+inputs:
+  map_asset:
+    type: nav.RosMapAsset/v1
+  request:
+    type: nav.PlanRequest/v1
+
+units:
+  map_decoder:
+    type: nav.ros_map_decoder/v1
+    config: {}
+    inputs:
+      asset: map_asset
+    outputs:
+      grid: occupancy_grid
+
+  inflation:
+    type: nav.binary_inflation/v1
+    config:
+      robot_radius_m: 0.35
+      unknown_as_obstacle: true
+    inputs:
+      grid: occupancy_grid
+    outputs:
+      costmap: navigation_costmap
+
+  planner:
+    type: nav.astar/v1
+    config:
+      diagonal_motion: true
+    inputs:
+      costmap: navigation_costmap
+      request: request
+    outputs:
+      plan: raw_plan
+
+  smoother:
+    type: nav.line_of_sight_smoother/v1
+    config: {}
+    inputs:
+      costmap: navigation_costmap
+      plan: raw_plan
+    outputs:
+      plan: final_plan
+
+outputs:
+  plan: final_plan
