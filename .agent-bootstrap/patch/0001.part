diff --git a/crates/unit-compose-core/src/config.rs b/crates/unit-compose-core/src/config.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0ccd1e24a6a7e843f1ab2f27269417b508e6d79a
--- /dev/null
+++ b/crates/unit-compose-core/src/config.rs
@@ -0,0 +1,136 @@
+use std::collections::BTreeMap;
+use std::fmt;
+
+/// A serialization-neutral configuration tree used by Unit factories.
+///
+/// The YAML frontend compiles source text into this type. Future JSON or
+/// programmatic frontends can produce the same logical representation.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ConfigValue {
+    Null,
+    Bool(bool),
+    Number(f64),
+    String(String),
+    Sequence(Vec<Self>),
+    Mapping(BTreeMap<String, Self>),
+}
+
+impl Default for ConfigValue {
+    fn default() -> Self {
+        Self::Mapping(BTreeMap::new())
+    }
+}
+
+impl ConfigValue {
+    pub fn mapping() -> Self {
+        Self::default()
+    }
+
+    pub fn as_mapping(&self) -> Option<&BTreeMap<String, Self>> {
+        match self {
+            Self::Mapping(value) => Some(value),
+            _ => None,
+        }
+    }
+
+    pub fn as_sequence(&self) -> Option<&[Self]> {
+        match self {
+            Self::Sequence(value) => Some(value),
+            _ => None,
+        }
+    }
+
+    pub fn as_str(&self) -> Option<&str> {
+        match self {
+            Self::String(value) => Some(value),
+            _ => None,
+        }
+    }
+
+    pub fn as_bool(&self) -> Option<bool> {
+        match self {
+            Self::Bool(value) => Some(*value),
+            _ => None,
+        }
+    }
+
+    pub fn as_f64(&self) -> Option<f64> {
+        match self {
+            Self::Number(value) => Some(*value),
+            _ => None,
+        }
+    }
+
+    pub fn get(&self, key: &str) -> Option<&Self> {
+        self.as_mapping()?.get(key)
+    }
+
+    pub fn get_bool(&self, key: &str) -> Option<bool> {
+        self.get(key)?.as_bool()
+    }
+
+    pub fn get_f64(&self, key: &str) -> Option<f64> {
+        self.get(key)?.as_f64()
+    }
+
+    pub fn get_str(&self, key: &str) -> Option<&str> {
+        self.get(key)?.as_str()
+    }
+
+    pub fn kind_name(&self) -> &'static str {
+        match self {
+            Self::Null => "null",
+            Self::Bool(_) => "bool",
+            Self::Number(_) => "number",
+            Self::String(_) => "string",
+            Self::Sequence(_) => "sequence",
+            Self::Mapping(_) => "mapping",
+        }
+    }
+}
+
+impl fmt::Display for ConfigValue {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Null => write!(formatter, "null"),
+            Self::Bool(value) => write!(formatter, "{value}"),
+            Self::Number(value) => write!(formatter, "{value}"),
+            Self::String(value) => write!(formatter, "\"{value}\""),
+            Self::Sequence(values) => {
+                write!(formatter, "[")?;
+                for (index, value) in values.iter().enumerate() {
+                    if index > 0 {
+                        write!(formatter, ", ")?;
+                    }
+                    write!(formatter, "{value}")?;
+                }
+                write!(formatter, "]")
+            }
+            Self::Mapping(values) => {
+                write!(formatter, "{{")?;
+                for (index, (key, value)) in values.iter().enumerate() {
+                    if index > 0 {
+                        write!(formatter, ", ")?;
+                    }
+                    write!(formatter, "{key}: {value}")?;
+                }
+                write!(formatter, "}}")
+            }
+        }
+    }
+}
diff --git a/crates/unit-compose-core/src/debug.rs b/crates/unit-compose-core/src/debug.rs
new file mode 100644
index 0000000000000000000000000000000000000000..77227a00436d5cb38aeb9786ec79a017d439972f
--- /dev/null
+++ b/crates/unit-compose-core/src/debug.rs
@@ -0,0 +1,239 @@
+use crate::ConfigValue;
+use std::collections::BTreeMap;
+use std::fmt::Write;
+use std::time::Duration;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DebugUnit {
+    pub instance: String,
+    pub type_name: String,
+    pub config_summary: String,
+    pub inputs: BTreeMap<String, String>,
+    pub outputs: BTreeMap<String, String>,
+}
+
+impl DebugUnit {
+    pub fn from_config(
+        instance: String,
+        type_name: String,
+        config: &ConfigValue,
+        inputs: BTreeMap<String, String>,
+        outputs: BTreeMap<String, String>,
+    ) -> Self {
+        Self {
+            instance,
+            type_name,
+            config_summary: config.to_string(),
+            inputs,
+            outputs,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ResourceProducer {
+    ModuleInput,
+    UnitOutput { unit: String, port: String },
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ResourceConsumer {
+    pub unit: String,
+    pub port: String,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DebugResource {
+    pub name: String,
+    pub semantic_type: String,
+    pub producer: ResourceProducer,
+    pub consumers: Vec<ResourceConsumer>,
+    pub module_outputs: Vec<String>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DebugGraph {
+    pub module: String,
+    pub schema: String,
+    pub units: Vec<DebugUnit>,
+    pub resources: Vec<DebugResource>,
+    pub execution_order: Vec<String>,
+    pub warnings: Vec<String>,
+}
+
+impl DebugGraph {
+    pub fn describe(&self) -> String {
+        let mut text = String::new();
+        let _ = writeln!(text, "Module: {} ({})", self.module, self.schema);
+        let _ = writeln!(text, "Execution order: {}", self.execution_order.join(" -> "));
+        let _ = writeln!(text, "Units:");
+        for unit in &self.units {
+            let _ = writeln!(
+                text,
+                "  - {} [{}] config={}",
+                unit.instance, unit.type_name, unit.config_summary
+            );
+        }
+        let _ = writeln!(text, "Resources:");
+        for resource in &self.resources {
+            let producer = match &resource.producer {
+                ResourceProducer::ModuleInput => "module input".to_owned(),
+                ResourceProducer::UnitOutput { unit, port } => format!("{unit}.{port}"),
+            };
+            let readers = resource
+                .consumers
+                .iter()
+                .map(|reader| format!("{}.{}", reader.unit, reader.port))
+                .collect::<Vec<_>>()
+                .join(", ");
+            let _ = writeln!(
+                text,
+                "  - {}: {} <- {} -> [{}]",
+                resource.name, resource.semantic_type, producer, readers
+            );
+        }
+        if !self.warnings.is_empty() {
+            let _ = writeln!(text, "Warnings:");
+            for warning in &self.warnings {
+                let _ = writeln!(text, "  - {warning}");
+            }
+        }
+        text
+    }
+
+    pub fn to_dot(&self) -> String {
+        let mut dot = String::from("digraph UnitCompose {\n  rankdir=LR;\n");
+        for unit in &self.units {
+            let _ = writeln!(
+                dot,
+                "  \"unit:{}\" [shape=box,style=rounded,label=\"{}\\n{}\"];",
+                escape_dot(&unit.instance),
+                escape_dot(&unit.instance),
+                escape_dot(&unit.type_name)
+            );
+        }
+        for resource in &self.resources {
+            let _ = writeln!(
+                dot,
+                "  \"resource:{}\" [shape=ellipse,label=\"{}\\n{}\"];",
+                escape_dot(&resource.name),
+                escape_dot(&resource.name),
+                escape_dot(&resource.semantic_type)
+            );
+            if let ResourceProducer::UnitOutput { unit, port } = &resource.producer {
+                let _ = writeln!(
+                    dot,
+                    "  \"unit:{}\" -> \"resource:{}\" [label=\"{}\"];",
+                    escape_dot(unit),
+                    escape_dot(&resource.name),
+                    escape_dot(port)
+                );
+            }
+            for consumer in &resource.consumers {
+                let _ = writeln!(
+                    dot,
+                    "  \"resource:{}\" -> \"unit:{}\" [label=\"{}\"];",
+                    escape_dot(&resource.name),
+                    escape_dot(&consumer.unit),
+                    escape_dot(&consumer.port)
+                );
+            }
+        }
+        dot.push_str("}\n");
+        dot
+    }
+
+    pub fn to_mermaid(&self) -> String {
+        let mut text = String::from("flowchart LR\n");
+        let unit_ids = self
+            .units
+            .iter()
+            .enumerate()
+            .map(|(index, unit)| (unit.instance.as_str(), format!("U{index}")))
+            .collect::<BTreeMap<_, _>>();
+        let resource_ids = self
+            .resources
+            .iter()
+            .enumerate()
+            .map(|(index, resource)| (resource.name.as_str(), format!("R{index}")))
+            .collect::<BTreeMap<_, _>>();
+        for unit in &self.units {
+            let id = &unit_ids[unit.instance.as_str()];
+            let _ = writeln!(
+                text,
+                "  {id}[\"{}<br/><small>{}</small>\"]",
+                escape_mermaid(&unit.instance),
+                escape_mermaid(&unit.type_name)
+            );
+        }
+        for resource in &self.resources {
+            let id = &resource_ids[resource.name.as_str()];
+            let _ = writeln!(
+                text,
+                "  {id}((\"{}<br/><small>{}</small>\"))",
+                escape_mermaid(&resource.name),
+                escape_mermaid(&resource.semantic_type)
+            );
+            if let ResourceProducer::UnitOutput { unit, port } = &resource.producer {
+                let _ = writeln!(
+                    text,
+                    "  {} -->|{}| {id}",
+                    unit_ids[unit.as_str()],
+                    escape_mermaid(port)
+                );
+            }
+            for consumer in &resource.consumers {
+                let _ = writeln!(
+                    text,
+                    "  {id} -->|{}| {}",
+                    escape_mermaid(&consumer.port),
+                    unit_ids[consumer.unit.as_str()]
+                );
+            }
+        }
+        text
+    }
+}
+
+fn escape_dot(value: &str) -> String {
+    value.replace('\\', "\\\\").replace('"', "\\\"")
+}
+
+fn escape_mermaid(value: &str) -> String {
+    value.replace('"', "&quot;")
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum UnitRunStatus {
+    Succeeded,
+    Failed,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct UnitTiming {
+    pub unit_instance: String,
+    pub unit_type: String,
+    pub duration: Duration,
+    pub status: UnitRunStatus,
+    pub error: Option<String>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct RunReport {
+    pub module: String,
+    pub run_id: u64,
+    pub total_duration: Duration,
+    pub unit_timings: Vec<UnitTiming>,
+}
+
+impl RunReport {
+    pub fn empty(module: impl Into<String>, run_id: u64) -> Self {
+        Self {
+            module: module.into(),
+            run_id,
+            total_duration: Duration::ZERO,
+            unit_timings: Vec::new(),
+        }
+    }
+}

diff --git a/crates/unit-compose-core/src/definition.rs b/crates/unit-compose-core/src/definition.rs
new file mode 100644
index 0000000000000000000000000000000000000000..65f33e45ab9c77460a7d9c79860dc286eab5ffb9
--- /dev/null
+++ b/crates/unit-compose-core/src/definition.rs
@@ -0,0 +1,62 @@
+use crate::ConfigValue;
+use std::collections::BTreeMap;
+
+pub const V0_SCHEMA: &str = "unit-compose/v0alpha1";
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ResourceDefinition {
+    pub semantic_type: String,
+}
+
+impl ResourceDefinition {
+    pub fn new(semantic_type: impl Into<String>) -> Self {
+        Self {
+            semantic_type: semantic_type.into(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct UnitDefinition {
+    pub type_name: String,
+    pub config: ConfigValue,
+    pub inputs: BTreeMap<String, String>,
+    pub outputs: BTreeMap<String, String>,
+}
+
+impl UnitDefinition {
+    pub fn new(type_name: impl Into<String>) -> Self {
+        Self {
+            type_name: type_name.into(),
+            config: ConfigValue::default(),
+            inputs: BTreeMap::new(),
+            outputs: BTreeMap::new(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ModuleDefinition {
+    pub schema: String,
+    pub module: String,
+    pub inputs: BTreeMap<String, ResourceDefinition>,
+    pub units: BTreeMap<String, UnitDefinition>,
+    pub outputs: BTreeMap<String, String>,
+}
+
+impl ModuleDefinition {
+    pub fn new(module: impl Into<String>) -> Self {
+        Self {
+            schema: V0_SCHEMA.to_owned(),
+            module: module.into(),
+            inputs: BTreeMap::new(),
+            units: BTreeMap::new(),
+            outputs: BTreeMap::new(),
+        }
+    }
+}
diff --git a/crates/unit-compose-core/src/error.rs b/crates/unit-compose-core/src/error.rs
new file mode 100644
index 0000000000000000000000000000000000000000..32d2563e885d3dc378b39b0be0970ff86dfe2f25
--- /dev/null
+++ b/crates/unit-compose-core/src/error.rs
@@ -0,0 +1,138 @@
+use crate::RunReport;
+use std::fmt;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum BuildErrorKind {
+    UnsupportedSchema,
+    InvalidDefinition,
+    UnknownUnitType,
+    InvalidConfiguration,
+    UnknownPort,
+    MissingBinding,
+    UnknownResource,
+    DuplicateProducer,
+    TypeMismatch,
+    Cycle,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ModuleBuildError {
+    pub module: Option<String>,
+    pub path: String,
+    pub kind: BuildErrorKind,
+    pub message: String,
+}
+
+impl ModuleBuildError {
+    pub fn new(
+        module: Option<&str>,
+        path: impl Into<String>,
+        kind: BuildErrorKind,
+        message: impl Into<String>,
+    ) -> Self {
+        Self {
+            module: module.map(str::to_owned),
+            path: path.into(),
+            kind,
+            message: message.into(),
+        }
+    }
+}
+
+impl fmt::Display for ModuleBuildError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if let Some(module) = &self.module {
+            write!(
+                formatter,
+                "module `{module}`: {} at `{}`: {}",
+                kind_label(self.kind),
+                self.path,
+                self.message
+            )
+        } else {
+            write!(
+                formatter,
+                "{} at `{}`: {}",
+                kind_label(self.kind),
+                self.path,
+                self.message
+            )
+        }
+    }
+}
+
+impl std::error::Error for ModuleBuildError {}
+
+fn kind_label(kind: BuildErrorKind) -> &'static str {
+    match kind {
+        BuildErrorKind::UnsupportedSchema => "unsupported schema",
+        BuildErrorKind::InvalidDefinition => "invalid definition",
+        BuildErrorKind::UnknownUnitType => "unknown Unit type",
+        BuildErrorKind::InvalidConfiguration => "invalid Unit configuration",
+        BuildErrorKind::UnknownPort => "unknown port",
+        BuildErrorKind::MissingBinding => "missing binding",
+        BuildErrorKind::UnknownResource => "unknown Resource",
+        BuildErrorKind::DuplicateProducer => "duplicate Resource producer",
+        BuildErrorKind::TypeMismatch => "Resource type mismatch",
+        BuildErrorKind::Cycle => "dependency cycle",
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct ModuleRunError {
+    pub module: String,
+    pub unit_instance: Option<String>,
+    pub unit_type: Option<String>,
+    pub message: String,
+    pub report: RunReport,
+}
+
+impl ModuleRunError {
+    pub fn framework(module: &str, message: impl Into<String>, report: RunReport) -> Self {
+        Self {
+            module: module.to_owned(),
+            unit_instance: None,
+            unit_type: None,
+            message: message.into(),
+            report,
+        }
+    }
+
+    pub fn unit(
+        module: &str,
+        unit_instance: &str,
+        unit_type: &str,
+        message: impl Into<String>,
+        report: RunReport,
+    ) -> Self {
+        Self {
+            module: module.to_owned(),
+            unit_instance: Some(unit_instance.to_owned()),
+            unit_type: Some(unit_type.to_owned()),
+            message: message.into(),
+            report,
+        }
+    }
+}
+
+impl fmt::Display for ModuleRunError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if let (Some(instance), Some(type_name)) = (&self.unit_instance, &self.unit_type) {
+            write!(
+                formatter,
+                "module `{}` failed in Unit `{instance}` ({type_name}): {}",
+                self.module, self.message
+            )
+        } else {
+            write!(formatter, "module `{}` failed: {}", self.module, self.message)
+        }
+    }
+}
+
+impl std::error::Error for ModuleRunError {}
