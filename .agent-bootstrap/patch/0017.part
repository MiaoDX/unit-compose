diff --git a/examples/navigation_planning/tests/v0_demo.rs b/examples/navigation_planning/tests/v0_demo.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d8cf7cb99ef7b510497475cb8024b40a3c069d0c
--- /dev/null
+++ b/examples/navigation_planning/tests/v0_demo.rs
@@ -0,0 +1,130 @@
+use navigation_planning_demo::resources::{
+    CostMap, PathPlan, PlanRequest, Point2, RosMapAsset, PLAN_REQUEST_TYPE,
+    ROS_MAP_ASSET_TYPE,
+};
+use navigation_planning_demo::register_navigation_units;
+use std::collections::BTreeMap;
+use std::fs;
+use std::path::{Path, PathBuf};
+use unit_compose_core::{BuildErrorKind, Module, ResourceValue, UnitRegistry};
+use unit_compose_yaml::parse_module_definition;
+
+fn root() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+}
+
+fn build(config: &str) -> Module {
+    let source = fs::read_to_string(root().join("configs").join(config)).unwrap();
+    let definition = parse_module_definition(&source).unwrap();
+    let mut registry = UnitRegistry::new();
+    register_navigation_units(&mut registry).unwrap();
+    Module::build(definition, &registry).unwrap()
+}
+
+fn run(module: &mut Module) -> unit_compose_core::RunResult {
+    module
+        .run(BTreeMap::from([
+            (
+                "map_asset".into(),
+                ResourceValue::new(
+                    ROS_MAP_ASSET_TYPE,
+                    RosMapAsset {
+                        metadata_path: root().join("assets/demo_map.yaml"),
+                    },
+                ),
+            ),
+            (
+                "request".into(),
+                ResourceValue::new(
+                    PLAN_REQUEST_TYPE,
+                    PlanRequest {
+                        start: Point2::new(1.25, 1.25),
+                        goal: Point2::new(9.25, 5.75),
+                    },
+                ),
+            ),
+        ]))
+        .unwrap()
+}
+
+fn final_plan(result: &unit_compose_core::RunResult) -> &PathPlan {
+    result.outputs["plan"].downcast_ref::<PathPlan>().unwrap()
+}
+
+#[test]
+fn yaml_replaces_planner_without_host_changes() {
+    let mut astar = build("astar.yaml");
+    let mut dijkstra = build("dijkstra.yaml");
+    let astar_result = run(&mut astar);
+    let dijkstra_result = run(&mut dijkstra);
+    let astar_plan = final_plan(&astar_result);
+    let dijkstra_plan = final_plan(&dijkstra_result);
+    assert!(astar_plan.algorithm.starts_with("A*"));
+    assert!(dijkstra_plan.algorithm.starts_with("Dijkstra"));
+    assert_eq!(astar_plan.search_cost, dijkstra_plan.search_cost);
+    assert!(astar_plan.expanded_nodes < dijkstra_plan.expanded_nodes);
+}
+
+#[test]
+fn removing_smoother_changes_dag_and_output() {
+    let mut smoothed = build("astar.yaml");
+    let mut raw = build("astar_without_smoothing.yaml");
+    assert_eq!(smoothed.debug_graph().execution_order.len(), 4);
+    assert_eq!(raw.debug_graph().execution_order.len(), 3);
+    let smoothed_result = run(&mut smoothed);
+    let raw_result = run(&mut raw);
+    let smoothed_plan = final_plan(&smoothed_result);
+    let raw_plan = final_plan(&raw_result);
+    assert!(smoothed_plan.smoothed);
+    assert!(!raw_plan.smoothed);
+    assert!(smoothed_plan.cells.len() < raw_plan.cells.len());
+}
+
+#[test]
+fn final_path_never_enters_inflated_obstacles() {
+    let mut module = build("astar.yaml");
+    let result = run(&mut module);
+    let plan = final_plan(&result);
+    let costmap = result.debug_resources["navigation_costmap"]
+        .downcast_ref::<CostMap>()
+        .unwrap();
+    assert!(plan.cells.iter().all(|cell| !costmap.is_blocked(*cell)));
+}
+
+#[test]
+fn negative_fixtures_report_relevant_paths() {
+    let cases = [
+        (
+            "type_mismatch.yaml",
+            BuildErrorKind::TypeMismatch,
+            "units.planner.inputs.costmap",
+        ),
+        (
+            "unknown_unit.yaml",
+            BuildErrorKind::UnknownUnitType,
+            "units.planner.type",
+        ),
+        (
+            "duplicate_producer.yaml",
+            BuildErrorKind::DuplicateProducer,
+            "units.map_decoder.outputs.grid",
+        ),
+    ];
+    let mut registry = UnitRegistry::new();
+    register_navigation_units(&mut registry).unwrap();
+    for (fixture, expected_kind, expected_path) in cases {
+        let source = fs::read_to_string(
+            root()
+                .join(Path::new("tests/fixtures"))
+                .join(fixture),
+        )
+        .unwrap();
+        let definition = parse_module_definition(&source).unwrap();
+        let error = match Module::build(definition, &registry) {
+            Ok(_) => panic!("fixture `{fixture}` unexpectedly built"),
+            Err(error) => error,
+        };
+        assert_eq!(error.kind, expected_kind, "fixture: {fixture}");
+        assert_eq!(error.path, expected_path, "fixture: {fixture}");
+    }
+}
diff --git a/rust-toolchain.toml b/rust-toolchain.toml
new file mode 100644
index 0000000000000000000000000000000000000000..dd94bb92150e6d3b08801bdcecd726e03c5db08b
--- /dev/null
