diff --git a/scripts/bootstrap-rust.sh b/scripts/bootstrap-rust.sh
new file mode 100755
index 0000000000000000000000000000000000000000..1cd276f1f510f99b0cde009e4421a55ac3f3a9c6
--- /dev/null
+++ b/scripts/bootstrap-rust.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env sh
+set -eu
+
+TOOLCHAIN="1.85.0"
+
+if ! command -v rustup >/dev/null 2>&1; then
+  if ! command -v curl >/dev/null 2>&1; then
+    echo "curl is required to install rustup" >&2
+    exit 1
+  fi
+  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
+    | sh -s -- -y --profile minimal --default-toolchain "$TOOLCHAIN"
+  # shellcheck disable=SC1090
+  . "$HOME/.cargo/env"
+fi
+
+rustup toolchain install "$TOOLCHAIN" --profile minimal \
+  --component rustfmt --component clippy
+rustup override set "$TOOLCHAIN"
+
+rustc --version
+cargo --version
+cargo fmt --version
+cargo clippy --version
diff --git a/scripts/demo-all.sh b/scripts/demo-all.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b76ee0aaaa3e344d1eeb0a705399041d12a70141
--- /dev/null
+++ b/scripts/demo-all.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env sh
+set -eu
+
+OUT="target/unit-compose-demo"
+mkdir -p "$OUT"
+
+run_demo() {
+  config="$1"
+  name="$2"
+  cargo run -q -p navigation-planning-demo -- \
+    --module "examples/navigation_planning/configs/$config" \
+    --html "$OUT/$name.html" \
+    --dot "$OUT/$name.dot" \
+    --mermaid "$OUT/$name.mmd"
+}
+
+run_demo astar.yaml astar
+run_demo dijkstra.yaml dijkstra
+run_demo astar_without_smoothing.yaml astar-without-smoothing
+
+cat > "$OUT/index.html" <<'HTML'
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>UnitCompose V0 demo gallery</title><style>body{margin:0;background:#080b13;color:#f5f7fb;font:16px/1.5 system-ui,sans-serif}.wrap{max-width:1100px;margin:0 auto;padding:64px 24px}h1{font-size:52px;letter-spacing:-.05em;margin:0 0 14px}p{color:#9ba7bc;max-width:720px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}a{display:block;color:inherit;text-decoration:none;background:#111827;border:1px solid #26324a;border-radius:20px;padding:24px;transition:.2s}a:hover{transform:translateY(-4px);border-color:#7179ff}small{display:block;color:#54d9d1;text-transform:uppercase;letter-spacing:.1em;margin-bottom:9px}strong{display:block;font-size:22px}span{display:block;color:#9ba7bc;font-size:13px;margin-top:9px}@media(max-width:800px){.grid{grid-template-columns:1fr}h1{font-size:40px}}</style></head><body><div class="wrap"><h1>UnitCompose V0</h1><p>Three Module Definitions, one binary: compare implementation replacement and a structural DAG change.</p><div class="grid"><a href="astar.html"><small>4 Units</small><strong>A* + smoother</strong><span>Default Quickstart</span></a><a href="dijkstra.html"><small>4 Units</small><strong>Dijkstra + smoother</strong><span>Compatible Unit replacement</span></a><a href="astar-without-smoothing.html"><small>3 Units</small><strong>A* raw path</strong><span>YAML removes a Unit</span></a></div></div></body></html>
+HTML
+
+echo "Demo gallery: $OUT/index.html"
