+.nav-layout{{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(270px,.65fr);gap:18px;align-items:start}}.nav-canvas{{background:#090e19;border:1px solid #202a40;border-radius:20px;padding:14px;overflow:auto}}.nav-map{{display:block;width:100%;height:auto;min-width:680px;border-radius:12px;box-shadow:0 18px 60px rgba(0,0,0,.35)}}.cell.free{{fill:#f4f7fb}}.cell.obstacle{{fill:#20283a}}.cell.inflated{{fill:#ffd08a}}.cell.unknown{{fill:url(#unknown);background:#79839a}}.grid-line{{stroke:#8b96a8;stroke-width:.45;opacity:.18}}.raw-path{{fill:none;stroke:#6378ff;stroke-width:5;stroke-dasharray:10 7;stroke-linecap:round;stroke-linejoin:round;opacity:.72}}.final-path{{fill:none;stroke:#13b889;stroke-width:6.5;stroke-linecap:round;stroke-linejoin:round;filter:url(#pathGlow)}}.marker circle{{stroke:#fff;stroke-width:2.4}}.marker text{{fill:#fff;font-size:10px;font-weight:900;text-anchor:middle;dominant-baseline:central}}.marker.start circle{{fill:#10a976}}.marker.goal circle{{fill:#e45567}}.nav-side{{display:flex;flex-direction:column;gap:12px}}.nav-card{{background:#0a101c;border:1px solid #202a40;border-radius:17px;padding:16px}}.nav-card small{{display:block;color:#8390aa;text-transform:uppercase;letter-spacing:.09em;font-size:9px;margin-bottom:7px}}.nav-card strong{{font-size:18px;display:block}}.nav-card span{{display:block;color:#a6b1c7;font-size:11px;line-height:1.5;margin-top:6px}}.nav-metrics{{display:grid;grid-template-columns:1fr 1fr;gap:9px}}.nav-metrics .nav-card{{min-height:112px}}.nav-legend{{display:flex;flex-wrap:wrap;gap:11px;color:#9aa5bd;font-size:10px;padding:13px 2px 0}}.nav-legend span{{display:flex;align-items:center;gap:6px}}.nav-legend i{{width:13px;height:9px;border-radius:3px}}.legend-obstacle{{background:#20283a}}.legend-inflated{{background:#ffd08a}}.legend-raw{{background:#6378ff}}.legend-final{{background:#13b889}}.route-compare{{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}}.route-compare b{{font-size:23px}}.route-compare em{{font-style:normal;color:#5fe1bb;font-size:20px}}@media(max-width:950px){{.nav-layout{{grid-template-columns:1fr}}.nav-map{{min-width:620px}}}}
+</style>
+<div class="nav-layout">
+  <div><div class="nav-canvas">{svg}</div><div class="nav-legend"><span><i class="legend-obstacle"></i>source obstacle</span><span><i class="legend-inflated"></i>inflated cost</span><span><i class="legend-raw"></i>raw planner path</span><span><i class="legend-final"></i>final path</span></div></div>
+  <aside class="nav-side">
+    <article class="nav-card"><small>Selected implementation</small><strong>{algorithm}</strong><span>Configuration changes the implementation and DAG; host code remains unchanged.</span></article>
+    <div class="nav-metrics">
+      <article class="nav-card"><small>Expanded nodes</small><strong>{expanded}</strong><span>search frontier work</span></article>
+      <article class="nav-card"><small>Inflation radius</small><strong>{radius:.2} m</strong><span>collision clearance</span></article>
+      <article class="nav-card"><small>Raw path</small><strong>{raw_points}</strong><span>{raw_length:.2} m</span></article>
+      <article class="nav-card"><small>Final path</small><strong>{final_points}</strong><span>{final_length:.2} m</span></article>
+    </div>
+    <article class="nav-card"><small>Smoothing effect</small><div class="route-compare"><div><b>{raw_points}</b><span>waypoints</span></div><em>→</em><div><b>{final_points}</b><span>waypoints</span></div></div><span>{waypoint_reduction} waypoint(s) and {length_reduction:.2} m removed without crossing inflated cells.</span></article>
+    <article class="nav-card"><small>Request</small><strong>({sx:.2}, {sy:.2}) → ({gx:.2}, {gy:.2})</strong><span>world coordinates · map {map_width}×{map_height} · resolution {resolution:.2} m/cell</span></article>
+  </aside>
+</div>"#,
+        svg = svg,
+        algorithm = escape_html(&final_plan.algorithm),
+        expanded = final_plan.expanded_nodes,
+        radius = costmap.inflation_radius_m,
+        raw_points = raw_plan.cells.len(),
+        raw_length = raw_plan.length_m,
+        final_points = final_plan.cells.len(),
+        final_length = final_plan.length_m,
+        waypoint_reduction = waypoint_reduction,
+        length_reduction = length_reduction,
+        sx = request.start.x,
+        sy = request.start.y,
+        gx = request.goal.x,
+        gy = request.goal.y,
+        map_width = grid.width,
+        map_height = grid.height,
+        resolution = grid.resolution,
+    )
+}
+
+fn append_path(svg: &mut String, cells: &[GridCell], cell_size: f64, class: &str) {
+    if cells.is_empty() {
+        return;
+    }
+    let points = cells
+        .iter()
+        .map(|cell| {
+            format!(
+                "{:.1},{:.1}",
+                (cell.col as f64 + 0.5) * cell_size,
+                (cell.row as f64 + 0.5) * cell_size
+            )
+        })
+        .collect::<Vec<_>>()
+        .join(" ");
+    let _ = write!(svg, "<polyline class=\"{class}\" points=\"{points}\"/>");
+}
+
+fn append_marker(svg: &mut String, cell: GridCell, cell_size: f64, class: &str, label: &str) {
+    let x = (cell.col as f64 + 0.5) * cell_size;
+    let y = (cell.row as f64 + 0.5) * cell_size;
+    let _ = write!(
+        svg,
+        "<g class=\"marker {class}\"><circle cx=\"{x:.1}\" cy=\"{y:.1}\" r=\"9\"/><text x=\"{x:.1}\" y=\"{y:.1}\">{label}</text></g>"
+    );
+}
