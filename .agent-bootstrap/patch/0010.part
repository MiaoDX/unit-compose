+        "<g class=\"{class}\" transform=\"translate({:.1},{:.1})\" filter=\"url(#shadow)\"><rect width=\"{width}\" height=\"72\" rx=\"18\"/><text class=\"node-title\" x=\"16\" y=\"29\">{}</text><text class=\"node-subtitle\" x=\"16\" y=\"51\">{}</text></g>",
+        node.x,
+        node.y,
+        truncate(&node.title, 23),
+        truncate(&node.subtitle, 27)
+    );
+}
+
+fn truncate(value: &str, max_chars: usize) -> String {
+    let escaped = escape_html(value);
+    if value.chars().count() <= max_chars {
+        return escaped;
+    }
+    let short = value.chars().take(max_chars.saturating_sub(1)).collect::<String>();
+    format!("{}…", escape_html(&short))
+}
+
+pub fn escape_html(value: &str) -> String {
+    value
+        .replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+        .replace('"', "&quot;")
+        .replace('\'', "&#39;")
+}
+
+fn escape_attr(value: &str) -> String {
+    escape_html(value)
+}
+
+const SCRIPT: &str = r#"
+const tabs = document.querySelectorAll('.tab');
+const panels = document.querySelectorAll('.panel');
+tabs.forEach(tab => tab.addEventListener('click', () => {
+  tabs.forEach(item => item.classList.remove('active'));
+  panels.forEach(item => item.classList.remove('active'));
+  tab.classList.add('active');
+  document.querySelector('#panel-' + CSS.escape(tab.dataset.panel)).classList.add('active');
+}));
+"#;
+
+const STYLES: &str = r#"
+:root{color-scheme:dark;--bg:#070a12;--panel:#0e1321;--panel2:#131a2b;--text:#f6f7fb;--muted:#9aa5bd;--line:#25304a;--violet:#7c83ff;--cyan:#3bd9d2;--green:#67e8a5;--amber:#ffc56e;--red:#ff7d8c;--shadow:0 24px 80px rgba(0,0,0,.38)}
+*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 10% 0%,rgba(73,83,190,.22),transparent 32%),radial-gradient(circle at 100% 16%,rgba(30,164,166,.15),transparent 30%),var(--bg);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text);min-height:100vh}.shell{width:min(1480px,calc(100% - 40px));margin:0 auto;padding:38px 0 24px}.hero{display:flex;justify-content:space-between;gap:32px;align-items:flex-end;padding:14px 4px 28px}.brand{display:flex;align-items:center;gap:11px;color:#cbd3e6;font-size:13px;font-weight:750;letter-spacing:.08em;text-transform:uppercase}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:linear-gradient(135deg,var(--violet),var(--cyan));color:#070a12;font-weight:900;letter-spacing:-.04em}.hero h1{font-size:clamp(34px,5vw,68px);line-height:.98;letter-spacing:-.055em;margin:27px 0 15px;max-width:950px}.hero p{margin:0;color:var(--muted);font-size:17px;line-height:1.65;max-width:840px}.run-state{display:flex;align-items:center;gap:12px;padding:15px 18px;border:1px solid var(--line);background:rgba(14,19,33,.78);border-radius:18px;box-shadow:var(--shadow);min-width:158px}.run-state small,.metric small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}.run-state strong{font-size:15px}.status-dot{width:12px;height:12px;border-radius:50%;background:var(--green);box-shadow:0 0 0 7px rgba(103,232,165,.1),0 0 24px rgba(103,232,165,.55)}.summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:16px}.metric{background:linear-gradient(145deg,rgba(19,26,43,.94),rgba(11,16,28,.94));border:1px solid var(--line);border-radius:19px;padding:18px 20px;min-height:116px;box-shadow:0 14px 42px rgba(0,0,0,.18)}.metric strong{display:block;font-size:22px;line-height:1.2;word-break:break-word}.metric span{display:block;color:var(--muted);font-size:12px;margin-top:8px}.workspace{display:grid;grid-template-columns:245px minmax(0,1fr);gap:16px}.tabs{display:flex;flex-direction:column;gap:8px;position:sticky;top:16px;align-self:start;padding:10px;background:rgba(10,14,24,.72);border:1px solid var(--line);border-radius:21px;backdrop-filter:blur(18px)}.tab{appearance:none;border:0;text-align:left;color:var(--muted);background:transparent;padding:14px 15px;border-radius:14px;cursor:pointer;transition:.2s ease;font:inherit}.tab span{display:block;color:#cbd3e6;font-size:14px;font-weight:720}.tab small{display:block;font-size:11px;margin-top:5px}.tab:hover{background:#151d31;transform:translateX(2px)}.tab.active{background:linear-gradient(135deg,rgba(124,131,255,.24),rgba(59,217,210,.12));box-shadow:inset 0 0 0 1px rgba(124,131,255,.28)}.tab.active span{color:#fff}.panel{display:none;background:linear-gradient(145deg,rgba(14,19,33,.97),rgba(8,12,21,.97));border:1px solid var(--line);border-radius:23px;min-height:620px;overflow:hidden;box-shadow:var(--shadow)}.panel.active{display:block;animation:reveal .25s ease}.panel-head{padding:23px 26px 18px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.012)}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:var(--cyan);font-weight:800}.panel h2{font-size:22px;letter-spacing:-.025em;margin:7px 0 0}.panel-body{padding:24px;overflow:auto}.graph-wrap{min-width:820px;border-radius:18px;background:radial-gradient(circle at 50% 40%,rgba(124,131,255,.08),transparent 42%),#090e19;border:1px solid #1d263b;overflow:auto}.dag{width:100%;height:auto;min-height:500px}.edge{fill:none;stroke:#59657d;stroke-width:1.7;opacity:.82}.dag marker path{fill:#697790}.edge-label{fill:#9eabc3;font-size:10px;text-anchor:middle;paint-order:stroke;stroke:#090e19;stroke-width:5}.node rect{stroke-width:1.2}.unit-node rect{fill:#5861dc;stroke:#8f96ff}.resource-node rect{fill:#151e31;stroke:#394868}.node-title{fill:#fff;font-size:13px;font-weight:800}.node-subtitle{fill:#c5cde0;font-size:9.5px}.legend{display:flex;flex-wrap:wrap;gap:18px;color:var(--muted);font-size:11px;padding:15px 2px}.legend span{display:flex;align-items:center;gap:7px}.legend i{width:14px;height:10px;border-radius:4px}.legend-unit{background:#5861dc}.legend-resource{background:#202b43;border:1px solid #4d5e80}.timing-list{display:flex;flex-direction:column;gap:10px}.timing-row{display:grid;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:14px;background:#0b101c;border:1px solid #202a40;padding:14px;border-radius:16px}.timing-index{width:38px;height:38px;display:grid;place-items:center;border-radius:12px;background:#151d30;color:#919db5;font:700 11px ui-monospace,monospace}.timing-label{display:flex;justify-content:space-between;gap:20px;align-items:start}.timing-label strong{font-size:14px}.timing-label span{display:block;color:var(--muted);font-size:10px;margin-top:4px}.timing-label b{font:700 12px ui-monospace,monospace;color:#dfe5f4}.timing-track{height:5px;border-radius:99px;background:#1c263a;margin-top:12px;overflow:hidden}.timing-track i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--violet),var(--cyan))}.badge{font-size:9px;font-weight:850;text-transform:uppercase;letter-spacing:.1em;border-radius:99px;padding:6px 8px}.badge.ok{color:var(--green);background:rgba(103,232,165,.08)}.badge.failed{color:var(--red);background:rgba(255,125,140,.1)}.error{color:var(--red);font-size:12px;margin:10px 0 0}.code-block{margin:0;background:#080c15;border:1px solid #1b2437;border-radius:16px;padding:20px;color:#cbd5e8;font:12px/1.75 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;word-break:break-word}footer{display:flex;justify-content:space-between;color:#66728a;font-size:11px;padding:18px 5px 0}@keyframes reveal{from{opacity:.35;transform:translateY(4px)}to{opacity:1;transform:none}}@media(max-width:1000px){.summary-grid{grid-template-columns:repeat(2,1fr)}.workspace{grid-template-columns:1fr}.tabs{position:static;flex-direction:row;overflow:auto}.tab{min-width:180px}.hero{align-items:flex-start}.run-state{display:none}}@media(max-width:620px){.shell{width:min(100% - 20px,1480px);padding-top:18px}.summary-grid{grid-template-columns:1fr}.hero h1{font-size:40px}.panel-body{padding:14px}.tabs{padding:7px}.tab{min-width:160px}footer{flex-direction:column;gap:6px}}
+"#;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+    use unit_compose_core::{DebugResource, DebugUnit, ResourceConsumer, UnitTiming};
+
+    #[test]
+    fn dashboard_is_self_contained_and_escaped() {
+        let graph = DebugGraph {
+            schema: "unit-compose/v0alpha1".into(),
+            module: "<demo>".into(),
+            units: vec![DebugUnit {
