+    pub fn new(values: BTreeMap<String, ResourceValue>) -> Self {
+        Self { values }
+    }
+
+    pub fn get(&self, port: &str) -> Option<&ResourceValue> {
+        self.values.get(port)
+    }
+
+    pub fn require<T>(&self, port: &str) -> Result<&T, UnitError>
+    where
+        T: Any,
+    {
+        let value = self
+            .get(port)
+            .ok_or_else(|| UnitError::new(format!("missing input port `{port}`")))?;
+        value.downcast_ref::<T>().ok_or_else(|| {
+            UnitError::new(format!(
+                "input port `{port}` has concrete type `{}`, expected `{}`",
+                value.concrete_type(),
+                type_name::<T>()
+            ))
+        })
+    }
+
+    pub fn iter(&self) -> impl Iterator<Item = (&str, &ResourceValue)> {
+        self.values
+            .iter()
+            .map(|(name, value)| (name.as_str(), value))
+    }
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct OutputSet {
+    values: BTreeMap<String, ResourceValue>,
+}
+
+impl OutputSet {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn insert(
+        &mut self,
+        port: impl Into<String>,
+        value: ResourceValue,
+    ) -> Option<ResourceValue> {
+        self.values.insert(port.into(), value)
+    }
+
+    pub fn into_inner(self) -> BTreeMap<String, ResourceValue> {
+        self.values
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct UnitError {
+    message: String,
+}
+
+impl UnitError {
+    pub fn new(message: impl Into<String>) -> Self {
+        Self {
+            message: message.into(),
+        }
+    }
+
+    pub fn message(&self) -> &str {
+        &self.message
+    }
+}
+
+impl fmt::Display for UnitError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.message)
+    }
+}
+
+impl std::error::Error for UnitError {}
+
+impl From<String> for UnitError {
+    fn from(value: String) -> Self {
+        Self::new(value)
+    }
+}
+
+impl From<&str> for UnitError {
+    fn from(value: &str) -> Self {
+        Self::new(value)
+    }
+}
diff --git a/crates/unit-compose-debug-html/Cargo.toml b/crates/unit-compose-debug-html/Cargo.toml
new file mode 100644
index 0000000000000000000000000000000000000000..31844b60f389c2faf4bfc101ce0e853fb4bffd5a
