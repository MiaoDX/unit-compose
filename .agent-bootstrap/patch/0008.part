@@ -0,0 +1,14 @@
+[package]
+name = "unit-compose-debug-html"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+rust-version.workspace = true
+repository.workspace = true
+description = "Self-contained HTML debug dashboard for UnitCompose V0"
+
+[dependencies]
+unit-compose-core = { path = "../unit-compose-core" }
+
+[lints]
+workspace = true
diff --git a/crates/unit-compose-debug-html/src/lib.rs b/crates/unit-compose-debug-html/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3155c1819086bc266619278fbdcb788b50dbce84
--- /dev/null
+++ b/crates/unit-compose-debug-html/src/lib.rs
@@ -0,0 +1,504 @@
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt::Write as _;
+use unit_compose_core::{
+    DebugGraph, ResourceProducer, RunReport, UnitRunStatus,
+};
+
+#[derive(Clone, Debug)]
+pub struct HtmlPanel {
+    pub id: String,
+    pub title: String,
+    pub eyebrow: String,
+    pub html: String,
+}
+
+impl HtmlPanel {
+    pub fn new(
+        id: impl Into<String>,
+        title: impl Into<String>,
+        eyebrow: impl Into<String>,
+        html: impl Into<String>,
+    ) -> Self {
+        Self {
+            id: id.into(),
+            title: title.into(),
+            eyebrow: eyebrow.into(),
+            html: html.into(),
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct DashboardOptions {
+    pub title: String,
+    pub subtitle: String,
+    pub generated_note: String,
+}
+
+impl DashboardOptions {
+    pub fn new(title: impl Into<String>, subtitle: impl Into<String>) -> Self {
+        Self {
+            title: title.into(),
+            subtitle: subtitle.into(),
+            generated_note: "Generated by UnitCompose Debug HTML".to_owned(),
+        }
+    }
+}
+
+/// Renders a self-contained HTML dashboard. The output has no CDN or runtime
+/// dependency and can be opened directly or shared as a single file.
+pub fn render_dashboard(
+    graph: &DebugGraph,
+    report: &RunReport,
+    options: &DashboardOptions,
+    extra_panels: &[HtmlPanel],
+) -> String {
+    let graph_panel = HtmlPanel::new(
+        "graph",
+        "Compiled Resource DAG",
+        "Static graph",
+        render_graph_svg(graph),
+    );
+    let timing_panel = HtmlPanel::new(
+        "timings",
+        "Unit execution timing",
+        format!("Run #{}", report.run_id),
+        render_timing_table(report),
+    );
+    let definition_panel = HtmlPanel::new(
+        "definition",
+        "Compiled module description",
+        "Normalized Debug view",
+        format!(
+            "<pre class=\"code-block\">{}</pre>",
+            escape_html(&graph.describe())
+        ),
+    );
+    let mut panels = extra_panels.to_vec();
+    panels.push(graph_panel);
+    panels.push(timing_panel);
+    panels.push(definition_panel);
+
+    let total_us = report.total_duration.as_micros();
+    let success_count = report
+        .unit_timings
+        .iter()
+        .filter(|timing| timing.status == UnitRunStatus::Succeeded)
+        .count();
+    let status = if success_count == report.unit_timings.len() {
+        "Succeeded"
+    } else {
+        "Failed"
+    };
+
+    let mut tabs = String::new();
+    let mut sections = String::new();
+    for (index, panel) in panels.iter().enumerate() {
+        let active = if index == 0 { " active" } else { "" };
+        let _ = write!(
+            tabs,
+            "<button class=\"tab{active}\" data-panel=\"{}\"><span>{}</span><small>{}</small></button>",
+            escape_attr(&panel.id),
+            escape_html(&panel.title),
+            escape_html(&panel.eyebrow)
+        );
+        let _ = write!(
+            sections,
+            "<section id=\"panel-{}\" class=\"panel{active}\"><div class=\"panel-head\"><div><span class=\"eyebrow\">{}</span><h2>{}</h2></div></div><div class=\"panel-body\">{}</div></section>",
+            escape_attr(&panel.id),
+            escape_html(&panel.eyebrow),
+            escape_html(&panel.title),
+            panel.html
+        );
+    }
+
+    format!(
+        r#"<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>{title}</title>
+<style>{styles}</style>
+</head>
+<body>
+<div class="shell">
+  <header class="hero">
+    <div>
+      <div class="brand"><span class="brand-mark">UC</span><span>UnitCompose · V0 demo</span></div>
+      <h1>{title}</h1>
+      <p>{subtitle}</p>
+    </div>
+    <div class="run-state"><span class="status-dot"></span><div><small>Run status</small><strong>{status}</strong></div></div>
+  </header>
+  <div class="summary-grid">
+    <article class="metric"><small>Module</small><strong>{module}</strong><span>{schema}</span></article>
+    <article class="metric"><small>Units executed</small><strong>{success_count}/{unit_count}</strong><span>stable topological order</span></article>
+    <article class="metric"><small>Total runtime</small><strong>{total_us} μs</strong><span>sequential V0 executor</span></article>
+    <article class="metric"><small>Resources</small><strong>{resource_count}</strong><span>{warning_count} validation warning(s)</span></article>
+  </div>
+  <div class="workspace">
+    <nav class="tabs">{tabs}</nav>
+    <main>{sections}</main>
+  </div>
+  <footer><span>{note}</span><span>Single-file, offline-shareable artifact</span></footer>
+</div>
+<script>{script}</script>
+</body>
+</html>"#,
+        title = escape_html(&options.title),
+        subtitle = escape_html(&options.subtitle),
+        status = status,
+        module = escape_html(&graph.module),
+        schema = escape_html(&graph.schema),
+        success_count = success_count,
+        unit_count = report.unit_timings.len(),
+        total_us = total_us,
+        resource_count = graph.resources.len(),
+        warning_count = graph.warnings.len(),
+        tabs = tabs,
+        sections = sections,
+        note = escape_html(&options.generated_note),
+        styles = STYLES,
+        script = SCRIPT,
